# ── Aegis MOS Environment Configuration ──────────────────────────────
# Copy this file to .env and fill in your values.

# ── Supabase Database ────────────────────────────────────────────────
# Get this from: Supabase Dashboard → Settings → Database → Connection string → URI
# Use the DIRECT connection (port 5432) for the backend, NOT the pooler (6543)
# Format: postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres.xxxxx:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── HMAC Secret Key (F6 — Command Signing) ───────────────────────────
# Generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
HMAC_SECRET_KEY=dev-secret-key-change-in-production

# ── Telemetry Storage ────────────────────────────────────────────────
# How often to persist telemetry to the database (every Nth tick)
# 1 = every tick (86,400 rows/day), 5 = every 5th tick (17,280 rows/day)
TELEMETRY_SAMPLE_RATE=1
